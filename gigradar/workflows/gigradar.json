        "jsCode": "// Upwork (Apify) → canonical\nlet pay = null;\nif ($json.hourly_min_amount) {\n  const cur = $json.hourly_currency || 'USD';\n  pay = $json.hourly_max_amount\n    ? `${cur} ${$json.hourly_min_amount}–${$json.hourly_max_amount}/hr`\n    : `${cur} ${$json.hourly_min_amount}/hr`;\n} else if ($json.budget_amount) {\n  pay = `${$json.budget_currency || 'USD'} ${$json.budget_amount} fixed`;\n}\n\nreturn {\n  json: {\n    source: 'upwork',\n    title: ($json.title || '').trim(),\n    url: $json.url || null,\n    company: null,          // Upwork clients are anonymous\n    pay,\n    type: $json.engagement_type || null,\n    posted_at: $json.published_at || null,\n    description: ($json.description || '').trim(),\n    skills: Array.isArray($json.skills) ? $json.skills : [],\n  }\n};"
