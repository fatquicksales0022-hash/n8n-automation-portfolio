        "jsCode": "// M4b — parse AI JSON + merge back onto the original job\nconst jobs = $('Remove Duplicates').all();      // ⚠️ dev: input to AI node is \"Remove Duplicates\"\nconst ai = $input.all();             // the 37 AI responses (same order)\n\nfunction parseScore(node) {\n  let raw =\n    node.json?.output?.[0]?.content?.[0]?.text ??\n    node.json?.content?.[0]?.text ??\n    node.json?.message?.content ??\n    node.json?.text ??\n    node.json;\n  if (typeof raw === 'string') { try { raw = JSON.parse(raw); } catch (e) { raw = {}; } }\n  return raw || {};\n}\n\nreturn jobs.map((job, i) => {\n  const s = parseScore(ai[i]);\n  return { json: {\n    ...job.json,\n    score:          Number(s.score) || 0,\n    reasons:        Array.isArray(s.reasons) ? s.reasons : [],\n    red_flags:      Array.isArray(s.red_flags) ? s.red_flags : [],\n    matched_skills: Array.isArray(s.matched_skills) ? s.matched_skills : [],\n  }};\n});"
      },
