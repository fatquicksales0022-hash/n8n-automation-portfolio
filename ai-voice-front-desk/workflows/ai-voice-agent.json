    {
      "parameters": {
        "httpMethod": "POST",
        "path": "voice-respond",
        "responseMode": "responseNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        0
      ],
      "id": "04d8688f-8cf6-423d-b170-d489cc20cc99",
      "name": "Webhook",
      "webhookId": "665a86a5-2f07-4374-9e68-160c43e357f8"
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "=<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<Response>\n  <Say voice=\"Polly.Joanna\">{{ $json.output }}</Say>\n  <Gather input=\"speech\" action=\"https://patrick-n8n.onrender.com/webhook/voice-respond\" method=\"POST\" speechTimeout=\"auto\"/>\n  <Say voice=\"Polly.Joanna\">Thanks for calling. Goodbye.</Say>\n</Response>",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "text/xml"
              }
            ]
          }
        }
      },
