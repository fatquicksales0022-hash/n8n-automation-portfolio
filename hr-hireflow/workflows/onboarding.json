        "jsonBody": "={{ JSON.stringify({\n  model: \"gpt-4o-mini\",\n  response_format: { type: \"json_object\" },\n  messages: [\n    { role: \"system\", content: \"You are an HR onboarding assistant. Given a new hire's role, produce a practical, role-specific onboarding checklist. Return ONLY JSON of the form {\\\"items\\\":[{\\\"item\\\":string,\\\"owner\\\":\\\"IT\\\"|\\\"HR\\\"|\\\"Manager\\\"|\\\"Candidate\\\",\\\"due_day\\\":\\\"Day 1\\\"|\\\"Week 1\\\"|\\\"Month 1\\\",\\\"doc_required\\\":boolean}]}. Produce 8-12 items spanning IT provisioning, HR paperwork, manager 1:1s, and role-specific ramp-up. Set doc_required=true only where the new hire must personally submit a document (government ID, tax form, signed policy, professional certification).\" },\n    { role: \"user\", content: `New hire role: ${$json.fields.Role}. Name: ${$json.fields.Name}.` }\n  ]\n}) }}",
        "options": {}
