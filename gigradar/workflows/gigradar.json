      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// OnlineJobs.ph → canonical\nlet title = ($json.title || '').replace(/\\s+/g, ' ').trim();\nconst type = ($json.type || '').trim();\nif (type && title.endsWith(type)) {\n  title = title.slice(0, -type.length).trim();\n}\n\nlet url = ($json.url || '').replace(/\\\\/g, '/').trim();\nif (url.startsWith('/')) url = 'https://www.onlinejobs.ph' + url;\n\nconst description = ($json.description || '')\n  .replace(/\\[\\/jobseekers\\/[^\\]]*\\]/g, '')   // strip bracketed job-links\n  .replace(/See\\s*More/gi, '')                // strip \"See More\"\n  .trim();\n\nconst skills = (Array.isArray($json.skills) ? $json.skills : ($json.skills ? [$json.skills] : []))\n  .map(s => (s || '').trim())\n  .filter(Boolean);                           // drop empty strings\n\nreturn {\n  json: {\n    source: 'onlinejobs',\n    title,\n    url,\n    company: null,\n    pay: ($json.pay || '').trim() || null,\n    type: type || null,\n    posted_at: $json.posted_at || null,\n    description,\n    skills,\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
