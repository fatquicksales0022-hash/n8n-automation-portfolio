      "name": "Note 6f3c"
    },
    {
      "parameters": {
        "content": "### 1 · Error Trigger\nFires automatically whenever another workflow that names this one as its Error Workflow fails. Receives the full failure payload: the failed workflow's name, the node that broke, the error message, and a deep link to the exact failed run.",
        "height": 200,
        "width": 200
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -60,
        140
      ],
      "id": "e5f2ad83-edf5-4ba6-8bfc-58ea50d0d8e4",
      "name": "Note a266"
    },
    {
      "parameters": {
        "content": "### 2 · Format the alert\nA Set node collapses the raw payload into one readable block — workflow name, the failing node, the error text, timestamp, and a one-click link to the failed run. Keeps the alert human, not a JSON dump.",
        "height": 200,
        "width": 200
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
