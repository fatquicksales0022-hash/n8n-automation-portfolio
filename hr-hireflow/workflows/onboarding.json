    {
      "parameters": {
        "jsCode": "const out = [];\nconst httpItems = $input.all();\nfor (let i = 0; i < httpItems.length; i++) {\n  const parsed = JSON.parse(httpItems[i].json.choices[0].message.content);\n  const cand = $('Search records').all()[i].json.fields;\n  for (const it of parsed.items) {\n    out.push({ json: {\n      checklist_item: it.item,\n      owner: it.owner,\n      due_day: it.due_day,\n      doc_required: !!it.doc_required,\n      candidate: cand.Name,\n      email: cand.Email,\n      role: cand.Role\n    }});\n  }\n}\nreturn out;"
      },
