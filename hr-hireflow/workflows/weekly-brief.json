    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst now = Date.now();\nconst WEEK = 7 * 24 * 60 * 60 * 1000;\nconst byRole = {}, byStage = {};\nlet shortlist = 0, stale = 0;\nfor (const it of items) {\n  const f = it.json.fields;\n  byRole[f.Role]   = (byRole[f.Role]   || 0) + 1;\n  byStage[f.Stage] = (byStage[f.Stage] || 0) + 1;\n  if (f.Recommendation === 'Shortlist') shortlist++;\n  const created = new Date(it.json.createdTime).getTime();\n  if ((now - created) > WEEK && ['New', 'Screened'].includes(f.Stage)) stale++;\n}\nreturn [{ json: {\n  total: items.length,\n  byRole, byStage,\n  shortlist,\n  shortlistRate: items.length ? Math.round(100 * shortlist / items.length) : 0,\n  stale\n}}];"
      },
