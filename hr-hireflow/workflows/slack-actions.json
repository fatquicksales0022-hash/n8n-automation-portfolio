      "parameters": {
        "jsCode": "const p = JSON.parse($json.body.payload);\nconst action = p.actions[0];\nconst data = JSON.parse(action.value);   // {recordId, role, name, email} from the button\nreturn {\n  json: {\n    action_id: action.action_id,         // \"approve\" or \"decline\"\n    recordId: data.recordId,\n    role: data.role,\n    name: data.name,\n    email: data.email,\n    response_url: p.response_url,         // used later to update the card\n    clicked_by: p.user?.username\n  }\n};"
      },
