        "jsCode": "// LinkedIn (Apify) → canonical\nreturn {\n  json: {\n    source: 'linkedin',\n    title: ($json.title || '').trim(),\n    url: $json.linkedinUrl || null,\n    company: $json.company?.name || null,\n    pay: $json.salary?.text || null,\n    type: ($json.employmentType || '').replace(/_/g, ' ').trim() || null,\n    posted_at: $json.postedDate || null,\n    description: ($json.descriptionText || '').trim(),\n    skills: [],   // LinkedIn has no per-job skills; scorer reads description\n  }\n};"
